---
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";

const { projects } = SITE_CONTENT;
---

<Layout pageTitle="Projects" wide={true}>
  <section class="py-16">

    <!-- Header -->
    <div class="mb-16">
      <div class="mb-4 h-px w-12 bg-primary/50"></div>
      <h1 class="font-serif text-5xl font-bold tracking-tight text-black">Projects</h1>
      <p class="mt-3 text-sm text-black/40">Games, assets, and audio work by Thirteen Games.</p>
    </div>

    <!-- Project list -->
    <div class="flex flex-col gap-10">
      {projects.map((project, i) => (
        <div class="project-row" data-index={i}>

          <!-- Card -->
          <a href={`/projects/${project.slug}`} class="card-link block flex-shrink-0">
            <div class="tilt-card group relative overflow-hidden rounded-xl border border-neutral/20">

              <!-- Image -->
              <div class="relative overflow-hidden" style="height: 280px;">
                <Image
                  src={project.image}
                  alt={project.name}
                  width={600}
                  height={400}
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                />
                <div class="grain-overlay absolute inset-0 pointer-events-none opacity-25 mix-blend-overlay" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              </div>

              <!-- Footer -->
              <div class="relative px-6 py-5 border-t border-neutral/10">
                <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent"></div>
                <div class="relative">
                  <h3 class="font-serif text-xl font-medium text-primary">{project.name}</h3>
                  <p class="mt-1 text-sm text-neutral/50 flex items-center gap-2">
                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary/60"></span>
                    {project.category}
                  </p>
                </div>
              </div>
            </div>
          </a>

          <!-- Slide panel -->
          <div class="panel-wrapper">
            <div class="panel-inner">
              <p class="text-xs font-medium uppercase tracking-widest text-primary/70 mb-3">
                {project.category}
              </p>
              <h3 class="font-serif text-2xl font-bold text-white mb-4 leading-snug">
                {project.name}
              </h3>
              <p class="text-sm text-neutral/60 leading-relaxed mb-6">
                {project.info}
              </p>
              {project.techStack && project.techStack.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-8">
                  {project.techStack.map((tech) => (
                    <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs text-primary">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
              <a href={`/projects/${project.slug}`} class="btn-primary inline-block text-sm">
                View Project
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .project-row {
    display: flex;
    align-items: stretch;
    gap: 0;
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .project-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .card-link {
    width: 380px;
    flex-shrink: 0;
  }

  /* Slide panel */
  .panel-wrapper {
    overflow: hidden;
    width: 0;
    opacity: 0;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
  }

  .project-row:hover .panel-wrapper {
    width: 380px;
    opacity: 1;
  }

  .panel-inner {
    width: 380px;
    height: 100%;
    padding: 0 0 0 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid rgba(244, 167, 185, 0.15);
  }

  /* Tilt card */
  .tilt-card {
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    background: linear-gradient(160deg, rgba(28, 35, 45, 0.9) 0%, rgba(14, 13, 12, 0.95) 100%);
    box-shadow:
      0 2px 20px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(253, 245, 219, 0.05);
    transition: box-shadow 0.3s ease;
  }

  .tilt-card:hover {
    box-shadow:
      0 20px 50px rgba(232, 160, 191, 0.2),
      0 4px 20px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(253, 245, 219, 0.08);
  }

  .tilt-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 0.75rem;
    background: linear-gradient(
      var(--glow-angle, 0deg),
      #E8A0BF,
      transparent 40%,
      transparent 60%,
      #E8A0BF
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: -1;
    animation: glow-spin 4s linear infinite;
  }

  .tilt-card:hover::before {
    opacity: 1;
  }

  @keyframes glow-spin {
    0%   { --glow-angle: 0deg; }
    100% { --glow-angle: 360deg; }
  }

  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .grain-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
  }

  /* Mobile: stack vertically, no slide panel */
  @media (max-width: 767px) {
    .card-link {
      width: 100%;
    }

    .panel-wrapper {
      display: none;
    }

    .project-row {
      flex-direction: column;
    }
  }
</style>

<script>
  // Scroll reveal
  const rowObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.transitionDelay =
            (entry.target as HTMLElement).dataset.index
              ? `${parseInt((entry.target as HTMLElement).dataset.index!) * 120}ms`
              : '0ms';
          entry.target.classList.add('is-visible');
          rowObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.project-row').forEach((row) => rowObserver.observe(row));

  // 3D tilt effect on cards
  document.querySelectorAll('.tilt-card').forEach((card) => {
    const el = card as HTMLElement;

    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;

      const rotX = ((y - cy) / cy) * -8;
      const rotY = ((x - cx) / cx) * 8;

      el.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.02)`;
    });

    el.addEventListener('mouseleave', () => {
      el.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });
</script>
