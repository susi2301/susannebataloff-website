---
import Layout from "@layouts/Layout.astro";
import "../../styles/global.css";

const games = [
  {
    name: "Bombs & Cats",
    description: "Second game jam after several months of development. A small horror and ambient game where you work on a conveyor belt and inspect boxes. Your task is to spot the difference and decide if there is a cat inside or a bomb. The project focuses on expandable and scalable systems.",
    image: "/bombsandcats.png",
    itchLink: "https://dambthirteen.itch.io/bombs-cats",
    youtubeId: "cmVdCQMgNXQ",
  },
  {
    name: "DEIN SPIEL NAME",
    description: "Beschreibung...",
    image: "/gamejam1.png",
    itchLink: "https://itch.io/DEIN-LINK",
    youtubeId: "DEINE_VIDEO_ID",
    sketchfabId: "76b125b7e5eb4747888586676295c9e8",
  },
];
---

<Layout pageTitle="Game Jams" pageDescription="Game jam projects by Thirteen Games - quick prototypes and creative experiments.">
  <article class="py-12">

    <div class="mb-12 text-center">
      <p class="mb-2 text-sm font-medium uppercase tracking-wider text-primary">Community Events</p>
      <h1 class="font-sans text-4xl font-bold text-black sm:text-5xl md:text-6xl">Game Jams</h1>
      <p class="mt-4 font-mono text-base text-black/60">A collection of games built during game jams.</p>
    </div>

    <div class="space-y-20">
      {games.map((game) => (
        <div class="rounded-lg border border-neutral/20 bg-[#1c232d]/50 p-6 sm:p-8">

          {/* Header */}
          <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="font-sans text-2xl font-bold text-black">{game.name}</h2>
            <a href={game.itchLink} target="_blank" class="btn-primary inline-flex items-center gap-2">
            Play on itch.io
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
          </div>

          {/* Description */}
          <p class="mb-8 font-mono text-base text-black/70">{game.description}</p>

          {/* Image */}
          <div class="mb-8 overflow-hidden rounded-lg">
            <img
              src={game.image}
              alt={game.name}
              class="h-auto w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </div>

          {/* 3D Model */}
          {game.sketchfabId && (
            <div class="mb-8">
              <h3 class="mb-4 font-sans text-lg font-bold text-black">3D Model</h3>
              <div class="w-full overflow-hidden rounded-lg" style="aspect-ratio: 16/9;">
                <iframe
                  title={`${game.name} 3D Model`}
                  src={`https://sketchfab.com/models/${game.sketchfabId}/embed?autostart=1&ui_theme=dark`}
                  width="100%"
                  height="100%"
                  frameborder="0"
                  allow="autoplay; fullscreen; xr-spatial-tracking"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}

          {/* YouTube Video */}
          {game.youtubeId && (
            <div>
              <h3 class="mb-4 font-sans text-lg font-bold text-black">Gameplay Video</h3>
              <div class="relative w-full overflow-hidden rounded-lg" style="padding-bottom: 56.25%;">
                <iframe
                  class="absolute inset-0 h-full w-full"
                  src={`https://www.youtube.com/embed/${game.youtubeId}`}
                  title={`${game.name} Gameplay`}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}

        </div>
      ))}
    </div>

    {/* Back Link */}
    <div class="mt-12 border-t border-black/10 pt-8">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-black/60 transition hover:text-black"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Projects
      </a>
    </div>

  </article>
</Layout>