---
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";

export function getStaticPaths() {
  return SITE_CONTENT.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { name, category, description, image, gallery, techStack, linkPreview, linkSource } = project;
---

<Layout>
  <article class="py-12">

    {/* Hero Banner */}
    <div class="relative -mx-5 mb-12 h-64 overflow-hidden rounded-lg sm:h-80 md:h-96">
      <Image
        class="h-full w-full object-cover object-center"
        src={image}
        alt={name}
        width="1200"
        height="600"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 px-8 pb-8">
        <p class="mb-2 text-sm font-medium uppercase tracking-wider text-primary">{category}</p>
        <h1 class="font-serif text-4xl font-bold text-white sm:text-5xl md:text-6xl">{name}</h1>
      </div>
    </div>

    {/* Links */}
    <div class="mb-12 flex gap-4">
      {linkSource && (
        <a
          href={linkSource}
          target="_blank"
          class="rounded-full border border-neutral/30 px-6 py-3 text-sm text-white transition hover:bg-primary hover:border-primary"
        >
          Source Code
        </a>
      )}
      {linkPreview && (
        <a
          href={linkPreview}
          target="_blank"
          class="rounded-full border border-neutral/30 px-6 py-3 text-sm text-white transition hover:bg-primary hover:border-primary"
        >
          Live Preview
        </a>
      )}
    </div>

    {/* Description */}
    <div class="prose-section mb-16">
      <h2 class="mb-6 font-serif text-2xl font-bold text-white">About the Project</h2>
      <div class="text-base leading-relaxed text-neutral space-y-4" set:html={description} />
    </div>

    {/* Tech Stack */}
    {techStack && techStack.length > 0 && (
      <div class="mb-16">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Tech Stack</h2>
        <div class="flex flex-wrap gap-3">
          {techStack.map((tech) => (
            <span class="rounded-full border border-primary/40 bg-primary/10 px-5 py-2 text-sm text-primary">
              {tech}
            </span>
          ))}
        </div>
      </div>
    )}

    {/* Gallery */}
    {gallery && gallery.length > 0 && (
      <div class="mb-16">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Gallery</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {gallery.map((img, i) => (
            <div class="overflow-hidden rounded-lg">
              <Image
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                src={img}
                alt={`${name} screenshot ${i + 1}`}
                width="736"
                height="483"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Back Link */}
    <div class="mt-12 border-t border-neutral/20 pt-8">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-neutral transition hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Projects
      </a>
    </div>

  </article>
</Layout>