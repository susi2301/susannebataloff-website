---
import { SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import "../../styles/global.css";

export function getStaticPaths() {
  return SITE_CONTENT.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { name, category, description, image, gallery, techStack, linkPreview, linkSource } = project;
---

<Layout pageTitle={name} pageDescription={project.info}>
  <article class="py-12">

    {/* Hero Banner */}
    <div class="reveal reveal-up relative -mx-5 mb-12 h-64 overflow-hidden rounded-lg sm:h-80 md:h-96">
      <Image
        class="h-full w-full object-cover object-center"
        src={image}
        alt={name}
        width="1200"
        height="600"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 px-8 pb-8">
        <p class="mb-2 text-sm font-medium uppercase tracking-wider text-primary">{category}</p>
        <h1 class="font-serif text-4xl font-bold text-white sm:text-5xl md:text-6xl">{name}</h1>
      </div>
    </div>

    {/* Links */}
    <div class="reveal reveal-up mb-12 flex gap-4" style="transition-delay: 100ms;">
      {linkSource && (
        <a href={linkSource} target="_blank" class="btn-outline">
          Source Code
        </a>
      )}
      {linkPreview && (
        <a href={linkPreview} target="_blank" class="btn-outline">
          Live Preview
        </a>
      )}
    </div>

    {/* Description */}
    <div class="reveal reveal-left prose-section mb-16" style="transition-delay: 200ms;">
      <h2 class="mb-6 font-serif text-2xl font-bold text-white">About the Project</h2>
      <div class="text-base leading-relaxed text-neutral space-y-4" set:html={description} />
    </div>

    {/* YouTube Video */}
    {project.youtubeId && (
      <div class="reveal reveal-up mb-16" style="transition-delay: 300ms;">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Video</h2>
        <div class="relative w-full overflow-hidden rounded-lg" style="padding-bottom: 56.25%;">
          <iframe
            class="absolute inset-0 h-full w-full"
            src={`https://www.youtube.com/embed/${project.youtubeId}`}
            title={`${name} Video`}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    {/* Tech Stack */}
    {techStack && techStack.length > 0 && (
      <div class="reveal reveal-right mb-16" style="transition-delay: 400ms;">
        <h2 class="mb-6 font-serif text-2xl font-bold text-white">Tech Stack</h2>
        <div class="flex flex-wrap gap-3">
          {techStack.map((tech, i) => (
            <span
              class="reveal-tag rounded-full border border-primary/40 bg-primary/10 px-5 py-2 text-sm text-primary"
              style={`transition-delay: ${450 + i * 80}ms;`}
            >
              {tech}
            </span>
          ))}
        </div>
      </div>
    )}

    {/* Gallery */}
    {gallery && gallery.length > 0 && (
      <div class="mb-16">
        <h2 class="reveal reveal-up mb-6 font-serif text-2xl font-bold text-white" style="transition-delay: 500ms;">Gallery</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {gallery.map((img, i) => (
            <div
              class="reveal reveal-scale overflow-hidden rounded-lg"
              style={`transition-delay: ${550 + i * 120}ms;`}
            >
              <Image
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                src={img}
                alt={`${name} screenshot ${i + 1}`}
                width="736"
                height="483"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Back Link */}
    <div class="reveal reveal-up mt-12 border-t border-neutral/20 pt-8" style="transition-delay: 600ms;">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-neutral transition hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Projects
      </a>
    </div>

  </article>
</Layout>

<style>
  .reveal {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translate(0, 0) scale(1) !important;
  }

  .reveal-up {
    transform: translateY(40px);
  }

  .reveal-left {
    transform: translateX(-40px);
  }

  .reveal-right {
    transform: translateX(40px);
  }

  .reveal-scale {
    transform: scale(0.9);
  }

  .reveal-tag {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .reveal-tag.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal, .reveal-tag');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  reveals.forEach((el) => revealObserver.observe(el));
</script>