---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

const featured = SITE_CONTENT.projects[0];

const disciplines = [
  {
    title: "3D Game Art",
    desc: "Modeling, texturing, and environment art crafted for immersive game worlds.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L3 8.25l9 5.25 9-5.25L12 3z"/><path d="M3 15.75l9 5.25 9-5.25"/><path d="M3 12l9 5.25 9-5.25"/></svg>`,
  },
  {
    title: "Game Development",
    desc: "Full game development in Unity with C#, from concept to release-ready build.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M8 12h4m-2-2v4M14 12h2"/></svg>`,
  },
  {
    title: "Sound Design",
    desc: "Atmospheric SFX, ambient soundscapes, and dynamic audio that breathe life into gameplay.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  },
];
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />

  <!-- STUDIO / DISCIPLINES -->
  <section class="py-24 border-t border-neutral/10">
    <div class="mb-14 text-center">
      <div class="mx-auto mb-4 h-px w-12 bg-primary/50"></div>
      <h2 class="font-serif text-4xl font-bold tracking-tight text-white">Studio</h2>
      <p class="mt-3 text-sm text-neutral/40">Thirteen Games · Independent · Cologne, Germany</p>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {disciplines.map(({ title, desc, icon }, i) => (
        <div
          class="discipline-card rounded-xl border border-neutral/10 bg-white/[0.02] p-8 transition-all duration-300 hover:border-primary/30 hover:bg-primary/5"
          style={`transition-delay: ${i * 80}ms;`}
        >
          <div class="mb-5 text-primary" set:html={icon} />
          <h3 class="font-serif text-lg font-bold text-white mb-2">{title}</h3>
          <p class="text-sm text-neutral/50 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURED SPOTLIGHT -->
  <section class="pb-24">
    <div class="mb-8">
      <p class="text-xs tracking-widest uppercase text-primary/70 mb-2">Highlight</p>
      <h2 class="font-serif text-3xl font-bold text-white">Latest Work</h2>
    </div>
    <a
      href={`/projects/${featured.slug}`}
      class="spotlight-link group relative block overflow-hidden rounded-xl border border-neutral/10 transition-all duration-300 hover:border-primary/30"
    >
      <div class="relative h-72 sm:h-[420px] overflow-hidden">
        <Image
          src={featured.image}
          alt={featured.name}
          width={900}
          height={500}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 sm:p-12">
          <span class="inline-block mb-2 text-xs font-medium uppercase tracking-widest text-primary">
            {featured.category}
          </span>
          <h3 class="font-serif text-3xl sm:text-4xl font-bold text-white leading-tight">
            {featured.name}
          </h3>
          <p class="mt-3 max-w-md text-sm text-neutral/60 leading-relaxed">{featured.summary}</p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm text-white/80 transition-all duration-300 group-hover:text-white group-hover:gap-4">
            Explore Project
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- CTA -->
  <section class="pb-32 border-t border-neutral/10 pt-16 text-center">
    <p class="mb-2 font-serif text-2xl font-bold text-white">More than just games.</p>
    <p class="mb-8 text-sm text-neutral/50">Discover every project, asset, and collaboration by Thirteen Games.</p>
    <a href="/projects" class="btn-primary inline-flex items-center gap-3">
      All Projects
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </a>
  </section>
</Layout>

<style>
  .discipline-card {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  .discipline-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .spotlight-link {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease, border-color 0.3s ease;
  }

  .spotlight-link.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.discipline-card, .spotlight-link').forEach((el) => {
    observer.observe(el);
  });
</script>
