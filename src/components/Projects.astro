---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      projects.map(({ name, category, info, image, linkPreview, linkSource }, index) => {
        return (
          <div
            class="project-card opacity-0 translate-y-12"
            style={`transition-delay: ${index * 150}ms;`}
            data-index={index}
          >
            <div
              class="tilt-card group relative overflow-hidden rounded-lg border border-neutral/20 bg-[#1c232d]/85 transition-all duration-300 ease-out"
            >
              {/* Bild-Container */}
              <div class="relative h-56 w-full overflow-hidden sm:h-64">
                <Image
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
                  src={image}
                  alt={name}
                  width="736"
                  height="483"
                />

                {/* Grain Overlay */}
                <div class="grain-overlay absolute inset-0 pointer-events-none opacity-30 mix-blend-overlay" />

                {/* Hover Overlay - komplett schwarz mit Info-Text */}
                <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/0 transition-all duration-400 group-hover:bg-black/95">
                  <p class="mx-6 text-center text-sm text-neutral opacity-0 translate-y-4 transition-all duration-300 delay-100 group-hover:opacity-100 group-hover:translate-y-0">
                    {info}
                  </p>
                  <div class="mt-4 flex gap-4 opacity-0 translate-y-4 transition-all duration-300 delay-200 group-hover:opacity-100 group-hover:translate-y-0">
                    {linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        class="rounded-full border border-neutral/40 px-4 py-2 text-xs text-white transition hover:bg-primary hover:border-primary"
                      >
                        Source
                      </a>
                    )}
                    {linkPreview && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        class="rounded-full border border-neutral/40 px-4 py-2 text-xs text-white transition hover:bg-primary hover:border-primary"
                      >
                        Preview
                      </a>
                    )}
                  </div>
                </div>
              </div>

              {/* Card Info - Name + Category */}
              <div class="px-5 py-5">
                <h3 class="font-serif text-xl font-medium text-primary">
                  {name}
                </h3>
                <p class="mt-1 text-sm text-neutral/50">{category}</p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Section>

<style>
  .tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .tilt-card:hover {
    box-shadow: 0 20px 50px rgba(149, 24, 16, 0.2);
  }

  .project-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .grain-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
  }
</style>

<script>
  // Staggered Fade-In
  const cards = document.querySelectorAll('.project-card');

  const fadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  cards.forEach((card) => fadeObserver.observe(card));

  // 3D Tilt + Magnetic Cursor
  const tiltCards = document.querySelectorAll('.tilt-card');

  tiltCards.forEach((card) => {
    const el = card as HTMLElement;

    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      const pullX = ((x - centerX) / centerX) * 8;
      const pullY = ((y - centerY) / centerY) * 8;

      el.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateX(${pullX}px) translateY(${pullY}px) scale(1.03)`;
    });

    el.addEventListener('mouseleave', () => {
      el.style.transform = 'rotateX(0deg) rotateY(0deg) translateX(0px) translateY(0px) scale(1)';
    });
  });
</script>