---
import type { SiteConfig } from "@types";
import { SITE_CONTENT } from "@config";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
const email = SITE_CONTENT.hero.email;
const projects = SITE_CONTENT.projects;
---

<footer class="w-full border-t border-black/10 px-5 pt-14 pb-8 text-black">
  <div class="mx-auto max-w-3xl">

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 mb-12">

      <div>
        <h3 class="mb-4 font-sans text-lg font-bold text-black">Thirteen Games</h3>
        <p class="font-mono text-sm text-black/60 leading-relaxed">
          Independent game studio based in Cologne, Germany. Creating unique and innovative games.
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-black/40">Projects</h3>
        <ul class="space-y-2">
          {projects.map((project) => (
            <li>
              <a
                href={`/projects/${project.slug}`}
                class="text-sm text-black/60 transition hover:text-black"
              >
                {project.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/projects/gamejams"
              class="text-sm text-black/60 transition hover:text-black"
            >
              Game Jams
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-black/40">Connect</h3>
        <ul class="space-y-2">
          {socialLinks.map(({ text, href }) => (
            <li>
              <a
                href={href}
                target="_blank"
                class="text-sm text-black/60 transition hover:text-black"
              >
                {text}
              </a>
            </li>
          ))}
          <li>
            <a
              href={`mailto:${email}`}
              class="text-sm text-black/60 transition hover:text-black"
            >
              Email
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-black/10 pt-6 text-center">
      <p class="font-mono text-xs text-black/40">
        {author} © {currentYear}. <span>Designed & Developed by</span> Dani Lipke
      </p>
    </div>

  </div>
</footer>
