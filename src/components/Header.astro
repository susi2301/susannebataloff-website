---
import Menu from "@icons/Menu.astro";
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { navLinks } = Astro.props;
const currentPath = Astro.url.pathname;

// Split nav links: left half and right half around the center logo
const mid = Math.ceil(navLinks.length / 2);
const leftLinks = navLinks.slice(0, mid);
const rightLinks = navLinks.slice(mid);
---

<header class="site-header">

  <!-- Background image + overlay -->
  <div class="header-bg" aria-hidden="true"></div>
  <div class="header-overlay" aria-hidden="true"></div>

  <!-- Desktop layout: left nav | center logo | right nav -->
  <div class="header-inner">

    <!-- Left nav -->
    <nav class="header-nav" aria-label="Left navigation">
      <ul class="nav-list">
        {leftLinks.map((link) => {
          const isActive = currentPath === link.href ||
            (link.children && link.children.some(c => currentPath === c.href));
          return (
            <li class="nav-item-wrap relative group">
              <a
                href={link.href}
                class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
              >
                {link.text}
                {link.children && (
                  <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="2 4 6 8 10 4" />
                  </svg>
                )}
              </a>
              {link.children && (
                <ul class="dropdown">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class={`dropdown-link ${currentPath === child.href ? 'text-black' : 'text-black/60'}`}
                      >
                        {child.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Center: Schriftzug -->
    <a href="/" class="header-brand" aria-label="Home">
      <img
        src="/SusiSchriftzugNurText.png"
        alt="Susanne Bataloff"
        class="schriftzug"
      />
    </a>

    <!-- Right nav -->
    <nav class="header-nav" aria-label="Right navigation">
      <ul class="nav-list">
        {rightLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li class="nav-item-wrap">
              <a
                href={link.href}
                class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
              >
                {link.text}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile: hamburger (right side) -->
    <button
      type="button"
      id="menu-button"
      class="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu />
    </button>

  </div>

  <!-- Mobile dropdown -->
  <nav id="mobile-menu" class="mobile-menu hidden" aria-label="Mobile navigation">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="mobile-link">{link.text}</a>
          {link.children && (
            <ul class="mobile-sub">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} class="mobile-sub-link">{child.text}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
  }

  /* White background */
  .header-bg {
    position: absolute;
    inset: 0;
    background: #ffffff;
    z-index: 0;
  }

  /* Subtle bottom border instead of overlay */
  .header-overlay {
    position: absolute;
    inset: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    z-index: 1;
  }

  /* Inner layout: 3 equal columns */
  .header-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.75rem 2.5rem;
    gap: 1rem;
  }

  @media (max-width: 767px) {
    .header-inner {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 0.75rem 1.25rem;
    }
  }

  /* NAV */
  .header-nav {
    display: flex;
    align-items: center;
  }

  .header-nav:last-of-type {
    justify-content: flex-end;
  }

  @media (max-width: 767px) {
    .header-nav {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item-wrap {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0.5rem 0.75rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: #000000;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link--active {
    color: #000000;
  }

  .nav-chevron {
    width: 10px;
    height: 10px;
    transition: transform 0.2s ease;
  }

  .nav-item-wrap:hover .nav-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 180px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.6rem;
    padding: 0.4rem 0;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .nav-item-wrap:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.65);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .dropdown-link:hover {
    color: #000000;
    background: rgba(0, 0, 0, 0.04);
  }

  /* CENTER LOGO */
  .header-brand {
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
  }

  .schriftzug {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .header-brand:hover .schriftzug {
    opacity: 0.85;
    transform: scale(1.03);
  }

  @media (max-width: 767px) {
    .schriftzug {
      height: 38px;
    }
  }

  /* MOBILE BUTTON */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: rgba(0, 0, 0, 0.7);
    padding: 0.25rem;
  }

  @media (max-width: 767px) {
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      right: 1.25rem;
    }
  }

  /* MOBILE DROPDOWN */
  .mobile-menu {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.97);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding: 1rem 1.25rem 1.5rem;
  }

  .mobile-menu.hidden {
    display: none;
  }

  .mobile-link {
    display: block;
    padding: 0.6rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mobile-sub {
    list-style: none;
    padding: 0.25rem 0 0.5rem 1rem;
    margin: 0;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.35rem 0;
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.5);
    text-decoration: none;
  }

  .mobile-sub-link:hover {
    color: #000000;
  }
</style>

<script>
  const btn = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
