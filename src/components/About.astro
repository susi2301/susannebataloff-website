---
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name" | "email">;

const { description, name, email } = Astro.props;

const tools = [
  { src: "/ProgramIcons/UnrealEngine.png", name: "Unreal Engine" },
  { src: "/ProgramIcons/Unity.png",        name: "Unity" },
  { src: "/ProgramIcons/Godot.png",        name: "Godot" },
  { src: "/ProgramIcons/Blender.png",      name: "Blender" },
  { src: "/ProgramIcons/Z_Brush.png",      name: "ZBrush" },
  { src: "/ProgramIcons/Cascadeur.png",    name: "Cascadeur" },
  { src: "/ProgramIcons/Adobe_SubstancePainter.png", name: "Substance Painter" },
  { src: "/ProgramIcons/Adobe_Photoshop.png",        name: "Photoshop" },
];

const leftPolaroids = [
  { src: "/BildDani.png",  rotate: "-5deg", ty: "0px"  },
  { src: "/BildSusi2.png", rotate: "4deg",  ty: "32px" },
];
const rightPolaroids = [
  { src: "/BildSusi3.png", rotate: "6deg",  ty: "-24px" },
  { src: "/BildSusi4.png", rotate: "-3deg", ty: "20px"  },
];
---

<section class="about-section" id="about">

  <div class="about-header">
    <div class="accent-line"></div>
    <h2 class="about-title">About Me</h2>
  </div>

  <div class="about-layout">

    <div class="polaroid-col">
      {leftPolaroids.map(({ src, rotate, ty }) => (
        <div
          class="polaroid"
          style={`--br:${rotate};--bty:${ty};transform:rotate(${rotate}) translateY(${ty});`}
        >
          <img src={src} alt={name} class="polaroid-img" />
        </div>
      ))}
    </div>

    <div class="about-text">
      <div class="font-mono text-base text-black/70 leading-relaxed" set:html={description} />
      <div class="mt-10">
        <a class="btn-primary" href={"mailto:" + email}>Get in Touch</a>
      </div>
    </div>

    <div class="polaroid-col">
      {rightPolaroids.map(({ src, rotate, ty }) => (
        <div
          class="polaroid"
          style={`--br:${rotate};--bty:${ty};transform:rotate(${rotate}) translateY(${ty});`}
        >
          <img src={src} alt={name} class="polaroid-img" />
        </div>
      ))}
    </div>

  </div>

  <!-- ===== TOOLS & SOFTWARE ===== -->
  <div class="tools-wrap">
    <div class="tools-divider"></div>
    <p class="tools-eyebrow">Tools &amp; Software</p>
    <div class="tools-row">
      {tools.map(({ src, name: toolName }, i) => (
        <div class="tool-item" style={`animation-delay: ${(i * 0.18).toFixed(2)}s`}>
          <div class="tool-img-wrap">
            <img src={src} alt={toolName} class="tool-img" loading="lazy" />
          </div>
          <span class="tool-label">{toolName}</span>
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  .about-section {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 6rem 2rem 5rem;
  }

  .about-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .accent-line {
    width: 4rem;
    height: 1px;
    background: #F4A7B9;
    opacity: 0.5;
    margin: 0 auto 1.5rem;
  }

  .about-title {
    font-family: var(--font-sans, 'Chewy', sans-serif);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 700;
    color: #0E0D0C;
    letter-spacing: -2px;
    line-height: 1;
  }

  .about-layout {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    gap: 2rem;
    max-width: 1300px;
    margin: 0 auto;
    align-items: center;
  }

  .polaroid-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: center;
  }

  .polaroid {
    background: #ffffff;
    padding: 0.85rem 0.85rem 3rem;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.11),
      0 2px 8px  rgba(0, 0, 0, 0.06);
    will-change: transform;
    cursor: pointer;
    width: 240px;
    flex-shrink: 0;
  }

  .polaroid-img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .about-text {
    min-width: 0;
    padding: 0 1rem;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .about-layout {
      grid-template-columns: 220px 1fr 220px;
      gap: 1.5rem;
    }

    .polaroid {
      width: 200px;
    }

    .polaroid-img {
      height: 210px;
    }
  }

  /* ===== TOOLS ===== */
  .tools-wrap {
    max-width: 1000px;
    margin: 5rem auto 0;
    text-align: center;
  }

  .tools-divider {
    width: 5rem;
    height: 1px;
    background: linear-gradient(to right, transparent, #F4A7B9, transparent);
    margin: 0 auto 3rem;
    opacity: 0.6;
  }

  .tools-eyebrow {
    font-family: var(--font-display, 'Boldonse', serif);
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #F4A7B9;
    margin-bottom: 2.5rem;
  }

  .tools-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 2.75rem;
  }

  .tool-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    animation: tool-float 3.2s ease-in-out infinite;
  }

  .tool-item:hover {
    animation-play-state: paused;
  }

  @keyframes tool-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-9px); }
  }

  .tool-img-wrap {
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.35s ease;
    filter: drop-shadow(0 0 8px rgba(244, 167, 185, 0.4));
  }

  .tool-item:hover .tool-img-wrap {
    transform: scale(1.25);
    filter:
      drop-shadow(0 0 14px rgba(244, 167, 185, 0.9))
      drop-shadow(0 0 28px rgba(244, 167, 185, 0.45));
  }

  .tool-img {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .tool-label {
    font-family: var(--font-mono, 'Fragment Mono', monospace);
    font-size: 0.72rem;
    color: rgba(14, 13, 12, 0.55);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .tool-item:hover .tool-label {
    color: #F4A7B9;
  }

  @media (max-width: 768px) {
    .tools-wrap {
      margin-top: 3.5rem;
    }
    .tool-img-wrap {
      width: 62px;
      height: 62px;
    }
    .tool-img {
      width: 48px;
      height: 48px;
    }
    .tools-row {
      gap: 1.5rem 2rem;
    }
  }

  /* Mobile: stack everything */
  @media (max-width: 768px) {
    .about-section {
      padding: 4rem 1.5rem 3rem;
    }

    .about-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .polaroid-col {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
    }

    .polaroid {
      width: 150px;
    }

    .polaroid-img {
      height: 155px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.polaroid').forEach((el) => {
    const rotate = el.style.getPropertyValue('--br').trim();
    const ty     = el.style.getPropertyValue('--bty').trim();
    const base   = `rotate(${rotate}) translateY(${ty})`;

    el.addEventListener('mouseenter', () => {
      el.style.transition = 'none';
    });

    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const dx = (e.clientX - (rect.left + rect.width  / 2)) / (rect.width  / 2);
      const dy = (e.clientY - (rect.top  + rect.height / 2)) / (rect.height / 2);
      el.style.transform  = `${base} translate(${dx * 14}px, ${dy * 14}px) scale(1.06)`;
      el.style.boxShadow  = '0 18px 50px rgba(0,0,0,0.18), 0 4px 14px rgba(0,0,0,0.08)';
    });

    el.addEventListener('mouseleave', () => {
      el.style.transition = 'transform 0.55s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.45s ease';
      el.style.transform  = base;
      el.style.boxShadow  = '';
    });
  });
</script>
