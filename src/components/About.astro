---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name" | "email">;

const { description, name, email } = Astro.props;

const polaroids = [
  { src: "/BildDani.png",  rotate: "-4deg", ty: "0px"   },
  { src: "/BildSusi2.png", rotate: "3deg",  ty: "18px"  },
  { src: "/BildSusi3.png", rotate: "5deg",  ty: "8px"   },
  { src: "/BildSusi4.png", rotate: "-2deg", ty: "-8px"  },
];
---

<Section text="About Me" href="about">
  <div class="flex flex-col items-start gap-12 md:flex-row md:items-center md:gap-10">

    <div class="flex-1 min-w-0">
      <div class="font-mono text-base text-black/70 leading-relaxed" set:html={description} />
      <div class="mt-10">
        <a class="btn-primary" href={"mailto:" + email}>
          Get in Touch
        </a>
      </div>
    </div>

    <div class="polaroid-grid flex-shrink-0">
      {polaroids.map(({ src, rotate, ty }) => (
        <div
          class="polaroid"
          style={`--base-rotate: ${rotate}; --base-ty: ${ty}; transform: rotate(${rotate}) translateY(${ty});`}
        >
          <img src={src} alt={name} class="polaroid-img" />
        </div>
      ))}
    </div>

  </div>
</Section>

<style>
  .polaroid-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    width: 420px;
    padding: 1.25rem 0.75rem;
  }

  .polaroid {
    background: #ffffff;
    padding: 0.75rem 0.75rem 2.5rem;
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.10),
      0 2px 6px rgba(0, 0, 0, 0.06);
    will-change: transform;
    cursor: pointer;
  }

  .polaroid-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  @media (max-width: 767px) {
    .polaroid-grid {
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
    }

    .polaroid-img {
      height: 130px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.polaroid').forEach((el) => {
    const style = el.style;
    const rotate = style.getPropertyValue('--base-rotate').trim();
    const ty = style.getPropertyValue('--base-ty').trim();
    const base = `rotate(${rotate}) translateY(${ty})`;

    el.addEventListener('mouseenter', () => {
      el.style.transition = 'transform 0.1s ease, box-shadow 0.2s ease';
    });

    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / (rect.width / 2);
      const dy = (e.clientY - cy) / (rect.height / 2);
      const strength = 10;
      el.style.transform = `${base} translate(${dx * strength}px, ${dy * strength}px) scale(1.04)`;
      el.style.boxShadow = '0 12px 36px rgba(0,0,0,0.16), 0 4px 10px rgba(0,0,0,0.08)';
    });

    el.addEventListener('mouseleave', () => {
      el.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease';
      el.style.transform = base;
      el.style.boxShadow = '';
    });
  });
</script>
