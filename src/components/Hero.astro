---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="relative text-center" id="hero">

  <!-- Full width banner -->
  <div class="relative h-[320px] md:h-[420px] overflow-hidden">
    <img
      src="/thirteen-banner.png"
      alt="Thirteen Games"
      class="absolute inset-0 w-full h-full object-cover"
    />

    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-black/60"></div>

    <!-- Text over banner -->
    <div class="relative z-10 flex flex-col justify-center items-center h-full px-6">
      <h1
        class="font-serif text-5xl font-bold tracking-tightest text-white sm:text-7xl md:text-8xl"
      >
        {name}
      </h1>

      <p
        class="mt-4 font-serif text-2xl font-bold tracking-tighter text-primary sm:text-3xl md:text-4xl"
      >
        {specialty}
      </p>
    </div>
  </div>

  <!-- Summary + CTA -->
  <div class="max-w-2xl mx-auto px-6 py-10">
    <p class="mb-10 text-base font-normal text-neutral md:text-lg">
      {summary}
    </p>

    <a
      class="inline-block rounded-full bg-primary px-10 py-5 text-sm font-medium text-white transition hover:scale-105 hover:bg-red-600"
      href={`mailto:${email}`}
    >
      Get in Touch
    </a>
  </div>
</section>
