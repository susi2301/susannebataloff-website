---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="relative text-center" id="hero">

  <div class="relative h-[320px] md:h-[420px] overflow-hidden w-screen left-1/2 -translate-x-1/2">
    <img
      src="/thirteen-banner.png"
      alt="Thirteen Games"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black opacity-40"></div>
  </div>

  <div class="bg-black px-6 py-8">
    <h1 class="font-serif text-5xl font-bold text-white sm:text-7xl md:text-8xl">
      {name}
    </h1>
    <p class="mt-4 font-serif text-2xl font-bold text-primary sm:text-3xl md:text-4xl">
      {specialty}
    </p>
  </div>

  <div class="max-w-2xl mx-auto px-6 py-10">
    <p class="mb-10 text-base text-neutral md:text-lg">
      {summary}
    </p>
    
      class="inline-block rounded-full bg-primary px-10 py-5 text-sm font-medium text-white transition hover:scale-105"
      href={`mailto:${email}`}
    >
      Get in Touch
    </a>
  </div>
</section>